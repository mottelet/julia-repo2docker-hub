#!/bin/bash
set -euo pipefail

# The hub's serving nodes may have different CPU features than this build
# machine. Precompiling native code for the build machine can trigger an
# "illegal instruction" crash on nodes that lack one of those features at
# container start. These are the same multiversioning targets the official
# Julia binaries/Docker images use: a "fat binary" with variants for several
# CPU generations, so each node picks the best one it supports at runtime
# instead of everything being flattened to the lowest common denominator.
# See https://words.yuvi.in/post/pre-compiling-julia-docker/
case "$(uname -m)" in
    x86_64)
        export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1)"
        ;;
    aarch64|arm64)
        export JULIA_CPU_TARGET="generic;cortex-a57;thunderx2t99;carmel"
        ;;
    *)
        export JULIA_CPU_TARGET=generic
        ;;
esac

echo "Precompiling Julia environment (JULIA_CPU_TARGET=$JULIA_CPU_TARGET)..."
julia --project=. -e '
    using Pkg
    Pkg.instantiate()
    Pkg.precompile()

    # Force-load every top-level dependency once so its compiled
    # cache is baked into this image layer, not paid for by the
    # first user session on the hub.
    for pkg in keys(Pkg.project().dependencies)
        @eval using $(Symbol(pkg))
    end
'
